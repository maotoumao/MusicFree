{
  "name": "musicfree-desktop",
  "version": "0.6.2",
  "private": true,
  "description": "MusicFree desktop port (Electron + react-native-web), native Wayland support via Chromium Ozone",
  "license": "AGPL",
  "repository": {
    "type": "git",
    "url": "https://github.com/maotoumao/MusicFree"
  },
  "author": {
    "name": "猫头猫",
    "email": "lhx_xjtu@163.com"
  },
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "webpack --mode production",
    "build:renderer:dev": "webpack --mode development",
    "build": "npm run build:main && npm run build:renderer",
    "build:dev": "npm run build:main && npm run build:renderer:dev",
    "start": "cross-env-shell ELECTRON_OZONE_PLATFORM_HINT=auto electron .",
    "dev": "npm run build:dev && cross-env-shell ELECTRON_OZONE_PLATFORM_HINT=auto electron .",
    "dist": "npm run build && electron-builder --linux"
  },
  "dependencies": {
