    "css-loader": "^7.1.2",
    "dayjs": "^1.11.12",
    "deepmerge": "^4.3.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eventemitter3": "^5.0.1",
    "global": "^4.4.0",
